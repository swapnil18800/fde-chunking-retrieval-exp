# ── Database (Supabase Postgres, direct connection) ─────────────────────────
DATABASE_URL=
SUPABASE_URL=https://tsqjbikdzuriwwgguwpf.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# ── LLM providers ────────────────────────────────────────────────────────────
# Primary: Gemini free tier via the OpenAI-compatible endpoint (15 RPM / model; we round-robin)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_JUDGE_MODEL=gemini-3.5-flash
# Fallback / high-quality only when imperative
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER=gemini            # gemini | deepseek

# ── Local open-source models (downloaded to HF cache on first use) ───────────
EMBEDDING_MODEL=abhinand/MedEmbed-small-v0.1
EMBEDDING_DIM=384
RERANKER_MODEL=ncbi/MedCPT-Cross-Encoder
TORCH_DEVICE=auto              # auto | mps | cpu

# ── Tracing: langfuse | langsmith | off ──────────────────────────────────────
TRACING_PROVIDER=langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=fde-chunking-retrieval-exp

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
CACHE_DIR=.cache
